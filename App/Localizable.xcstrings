          }
        }
      }
    },
    "Allow the BatteryKeeper helper in System Settings to discharge on power.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许 BatteryKeeper 辅助进程，才能插着电放电。"
